#!/bin/bash
# Lets every person on the machine use Docker without sudo, and starts it, right
# after the docker package is installed (biglinux-docker.hook). Membership of the
# docker group is what grants access to /run/docker.sock; it takes effect at the
# next login.

# docker's sysusers.d entry normally creates the group already.
getent group docker > /dev/null || groupadd docker

# Accounts from UID 1000 up are people; nobody (65534) is not one.
while IFS=: read -r user _ uid _; do
    ((uid >= 1000)) || continue
    [[ $user == nobody ]] && continue
    usermod -aG docker "$user"
done < /etc/passwd

systemctl enable --now docker.service
