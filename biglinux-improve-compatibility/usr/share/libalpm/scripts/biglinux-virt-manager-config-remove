#!/usr/bin/bash
# Undoes biglinux-virt-manager-config-install before libvirt or
# biglinux-virt-manager-config is removed (z-biglinux-virt-manager-config-remove.hook):
# group membership, the bridging rule and libvirtd at boot. The default network
# goes back to the copy saved before the install script changed it; a network the
# script never touched stays as it is.

network=/etc/libvirt/qemu/networks/default.xml

while IFS=: read -r user _ uid _; do
    ((uid >= 1000)) || continue
    [[ $user == nobody ]] && continue
    gpasswd -d "$user" libvirt > /dev/null 2>&1
    gpasswd -d "$user" libvirt-qemu > /dev/null 2>&1
done < /etc/passwd

if [[ -e $network.bkp ]]; then
    mv -f "$network.bkp" "$network"
fi

if [[ -e /etc/qemu/bridge.conf ]]; then
    sed -i '/^allow all$/d' /etc/qemu/bridge.conf
fi

if [[ -e /usr/lib/systemd/system/libvirtd.service ]]; then
    systemctl disable --now libvirtd.service
fi
