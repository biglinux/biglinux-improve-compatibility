#!/bin/bash
# Pango no longer ships libpangox; programs built against it (old AUR and .deb
# packages) find libpangoxft under that name instead. Run by
# biglinux-improve-compatibility-pango.hook after pango or this package changes.
for source_lib in /usr/lib/libpangoxft-*; do
    [ -e "$source_lib" ] || continue
    compat_lib="${source_lib/libpangoxft/libpangox}"

    if [ ! -e "$compat_lib" ]; then
        ln -s "$source_lib" "$compat_lib" 2> /dev/null
    fi
done
