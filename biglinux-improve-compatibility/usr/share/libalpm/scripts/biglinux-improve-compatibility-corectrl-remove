#!/bin/bash
# Undoes biglinux-improve-compatibility-corectrl before the corectrl package is
# removed (biglinux-improve-compatibility-corectrl-remove.hook). A person's files
# go only while they are still the ones the install script wrote: settings changed
# in CoreCtrl stay.

if grep -q amdgpu.ppfeaturemask /etc/default/grub; then
    sed -i '/GRUB_CMDLINE_LINUX_DEFAULT/s/ amdgpu.ppfeaturemask=0xfffd7fff//' /etc/default/grub
    update-grub > /dev/null
fi

desktop_file=/usr/share/applications/org.corectrl.CoreCtrl.desktop
default_ini=$'[General]\nstartOnSysTray=true'

while IFS=: read -r user _ uid _ _ home _; do
    ((uid >= 1000)) || continue
    [[ $user == nobody ]] && continue
    [[ $home == /home/* || $home == /var/home/* ]] && [[ -d $home ]] || continue

    rm -f "/etc/polkit-1/rules.d/90-corectrl-$user.rules"

    # As the person, like the install script, so their links are never followed by root.
    runuser -u "$user" -- bash -c '
        home=$1 desktop_file=$2 default_ini=$3
        autostart_file=$home/.config/autostart/org.corectrl.CoreCtrl.desktop
        if [[ -f $autostart_file && -f $desktop_file && $(< "$autostart_file") == "$(< "$desktop_file")" ]]; then
            rm -f "$autostart_file"
        fi
        corectrl_ini=$home/.config/corectrl/corectrl.ini
        if [[ -f $corectrl_ini && $(< "$corectrl_ini") == "$default_ini" ]]; then
            rm -f "$corectrl_ini"
        fi
    ' bash "$home" "$desktop_file" "$default_ini"
done < /etc/passwd
