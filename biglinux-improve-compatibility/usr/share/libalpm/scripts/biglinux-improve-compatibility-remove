#!/bin/bash
# Deletes the kernel header links biglinux-improve-compatibility created
# (/usr/src/linux-headers-<version> and /usr/lib/modules/<version>/build/version)
# before this package is removed (biglinux-improve-compatibility-remove.hook).

for header_link in /usr/src/linux-headers-*; do
    [ -L "$header_link" ] || continue
    kernel_version="${header_link#/usr/src/linux-headers-}"
    rm -f "$header_link"
    if [ -L "/usr/lib/modules/$kernel_version/build/version" ]; then
        rm -f "/usr/lib/modules/$kernel_version/build/version"
    fi
done
