#!/bin/bash
# Undoes biglinux-install-virtualbox after the virtualbox package is removed
# (biglinux-virtualbox-remove.hook): deletes the vboxusers group and unloads the
# VirtualBox kernel modules that are still loaded.

if getent group vboxusers > /dev/null; then
    groupdel vboxusers
fi

for module in vboxnetflt vboxnetadp vboxdrv; do
    if grep -q "^$module " /proc/modules; then
        rmmod "$module"
    fi
done
