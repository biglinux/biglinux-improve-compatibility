#!/bin/bash
# Lets every person on the machine run VirtualBox machines with USB passthrough,
# right after the virtualbox package is installed (biglinux-virtualbox.hook):
# VirtualBox gives USB devices only to members of vboxusers.

getent group vboxusers > /dev/null || groupadd vboxusers

# Accounts from UID 1000 up are people; nobody (65534) is not one.
while IFS=: read -r user _ uid _; do
    ((uid >= 1000)) || continue
    [[ $user == nobody ]] && continue
    gpasswd -a "$user" vboxusers > /dev/null
done < /etc/passwd

# Load the kernel modules the new package brings, so no reboot is needed.
if command -v vboxreload > /dev/null; then
    vboxreload > /dev/null
fi
