#!/bin/bash
# Makes CoreCtrl usable right after the corectrl package is installed
# (biglinux-improve-compatibility-corectrl.hook):
#   - the amdgpu.ppfeaturemask kernel parameter unlocks AMD GPU clock and voltage
#     control, which CoreCtrl needs;
#   - a polkit rule per person lets their active local session start CoreCtrl's
#     helper without a password prompt;
#   - CoreCtrl starts minimized to the tray at login.
# biglinux-improve-compatibility-corectrl-remove undoes it.

if ! grep -q amdgpu.ppfeaturemask /etc/default/grub; then
    # Appends before the closing quote of GRUB_CMDLINE_LINUX_DEFAULT, single or double.
    sed -i -E "/^GRUB_CMDLINE_LINUX_DEFAULT=/s/([\"'])[[:space:]]*\$/ amdgpu.ppfeaturemask=0xfffd7fff\1/" /etc/default/grub
    if grep -q amdgpu.ppfeaturemask /etc/default/grub; then
        update-grub > /dev/null
    fi
fi

desktop_file=/usr/share/applications/org.corectrl.CoreCtrl.desktop
skel_profile=/etc/skel/.config/corectrl/profiles/_global_.ccpro

# Accounts from UID 1000 up with a home under /home are people.
while IFS=: read -r user _ uid _ _ home _; do
    ((uid >= 1000)) || continue
    [[ $user == nobody ]] && continue
    [[ $home == /home/* || $home == /var/home/* ]] && [[ -d $home ]] || continue

    cat > "/etc/polkit-1/rules.d/90-corectrl-$user.rules" << RULE
polkit.addRule(function(action, subject) {
    if ((action.id == "org.corectrl.helper.init" ||
        action.id == "org.corectrl.helperkiller.init") &&
        subject.local == true &&
        subject.active == true &&
        subject.isInGroup("$user")) {
            return polkit.Result.YES;
    }
});
RULE

    # As the person, so a link they placed in their home cannot point root's writes
    # elsewhere. Their own settings and profile are never replaced.
    runuser -u "$user" -- bash -c '
        home=$1 desktop_file=$2 skel_profile=$3
        mkdir -p "$home/.config/autostart" "$home/.config/corectrl/profiles"
        if [[ -e $desktop_file ]]; then
            cp "$desktop_file" "$home/.config/autostart/org.corectrl.CoreCtrl.desktop"
        fi
        if [[ ! -e $home/.config/corectrl/corectrl.ini ]]; then
            printf "[General]\nstartOnSysTray=true\n" > "$home/.config/corectrl/corectrl.ini"
        fi
        if [[ ! -e $home/.config/corectrl/profiles/_global_.ccpro && -e $skel_profile ]]; then
            cp "$skel_profile" "$home/.config/corectrl/profiles/_global_.ccpro"
        fi
    ' bash "$home" "$desktop_file" "$skel_profile"
done < /etc/passwd
