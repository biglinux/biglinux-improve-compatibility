#!/usr/bin/bash
# Sets up libvirt so virt-manager works for every person on the machine right after
# it is installed (z-biglinux-virt-manager-config-install.hook): group membership,
# a default NAT network that does not collide with the host's own, bridging, and
# libvirtd running at boot. The z- prefix runs it after the hooks of the libvirt
# packages themselves.

network=/etc/libvirt/qemu/networks/default.xml

# Accounts from UID 1000 up are people; nobody (65534) is not one.
while IFS=: read -r user _ uid _; do
    ((uid >= 1000)) || continue
    [[ $user == nobody ]] && continue
    usermod -a -G libvirt,libvirt-qemu "$user"

    # gsettings reaches the user's dconf through the session bus, which exists only
    # while the user is logged in; the keys exist only with virt-manager installed.
    runtime_dir=/run/user/$uid
    if [[ -d $runtime_dir && -e /usr/share/glib-2.0/schemas/org.virt-manager.virt-manager.gschema.xml ]]; then
        sudo -u "$user" XDG_RUNTIME_DIR="$runtime_dir" gsettings set org.virt-manager.virt-manager xmleditor-enabled true
        sudo -u "$user" XDG_RUNTIME_DIR="$runtime_dir" gsettings set org.virt-manager.virt-manager system-tray true
    fi
done < /etc/passwd

# The removal hook restores this copy.
if [[ -e $network && ! -e $network.bkp ]]; then
    cp "$network" "$network.bkp"
fi

# When the host already uses the default network's subnet (192.168.122.0/24 unless
# changed), move the network to the next /24. The network's own bridge carries that
# subnet once it is active, so it does not count.
if [[ -e $network ]]; then
    prefix=$(grep -oPm1 "(?<=ip address=')[0-9]+\.[0-9]+\.[0-9]+" "$network")
    bridge=$(grep -oPm1 "(?<=bridge name=')[^']+" "$network")
    if [[ -n $prefix ]] && ip -o -4 addr show | awk -v bridge="$bridge" '$2 != bridge' | grep -Fq " $prefix."; then
        IFS=. read -r a b c <<< "$prefix"
        sed -i "s/$prefix\./$a.$b.$((c + 1))./g" "$network"
    fi
fi

if [[ -e /etc/qemu/bridge.conf ]] && ! grep -qx 'allow all' /etc/qemu/bridge.conf; then
    echo 'allow all' >> /etc/qemu/bridge.conf
fi

systemctl enable --now libvirtd.service

# Define the default network if libvirt does not know it, then keep it active and
# started at boot. In a chroot (an image build) libvirtd is not running and virsh has
# nothing to talk to.
if systemctl is-active --quiet libvirtd.service && [[ -e $network ]]; then
    LANG=C virsh net-info default > /dev/null 2>&1 || LANG=C virsh net-define "$network" > /dev/null
    info=$(LANG=C virsh net-info default)
    [[ $info =~ Active:[[:space:]]+yes ]] || LANG=C virsh net-start default > /dev/null
    [[ $info =~ Autostart:[[:space:]]+yes ]] || LANG=C virsh net-autostart default > /dev/null
fi
