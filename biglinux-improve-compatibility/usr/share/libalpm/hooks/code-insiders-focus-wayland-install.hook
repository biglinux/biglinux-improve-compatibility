[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = code-insiders-bin

[Action]
Description = Pointing the VS Code Insiders menu entry at the /usr/local/bin wrapper that raises its window on Wayland
When = PostTransaction
Exec = /bin/sh -c 'f=/usr/share/applications/code-insiders.desktop; [ ! -e "$f" ] || sed -i "s|/usr/share/code-insiders/code-insiders|/usr/local/bin/code-insiders|g" "$f"'
