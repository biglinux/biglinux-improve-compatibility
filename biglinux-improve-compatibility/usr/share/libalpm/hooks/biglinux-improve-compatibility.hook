[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = linux*
Target = biglinux-improve-compatibility
Target = dav1d
Target = rav1e

[Trigger]
Type = Package
Operation = Remove
Target = linux*

[Action]
Description = Updating kernel header links and compatibility library links
When = PostTransaction
Exec = /usr/share/libalpm/scripts/biglinux-improve-compatibility
