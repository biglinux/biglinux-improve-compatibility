[Trigger]
Type = Package
Operation = Remove
Target = biglinux-improve-compatibility

[Action]
Description = Pointing the VS Code Insiders menu entry back at its own binary
When = PreTransaction
Exec = /bin/sh -c 'f=/usr/share/applications/code-insiders.desktop; [ ! -e "$f" ] || sed -i "s|/usr/local/bin/code-insiders|/usr/share/code-insiders/code-insiders|g" "$f"'
