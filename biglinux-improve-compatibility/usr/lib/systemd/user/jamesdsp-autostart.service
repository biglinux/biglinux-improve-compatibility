[Unit]
Description=Jamesdsp Autostart

# If jamesdsp is set to start automatically, this file will indeed start.
Requires=pipewire-pulse.socket
ConditionUser=!root
Wants=pipewire.service pipewire-session-manager.service
After=pipewire.service pipewire-session-manager.service
Conflicts=pulseaudio.service

# JamesDSP also has its own autostart mechanism, ~/.config/autostart/jdsp-gui.desktop,
# which it rewrites whenever the option is toggled in its GUI. Both used to fire at
# login and the loser failed the D-Bus single-instance check; with Restart=on-failure
# that looped, and a short-lived instance eventually tore down the PipeWire filter,
# leaving jamesdsp_sink with no route to the real sink. The second ExecCondition below
# makes the two mutually exclusive instead.
#
# Keep a real rate limit: the default RestartSec=1s with burst 10 never trips, because
# ten 1s restarts span longer than the 10s window.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple

# All ExecCondition= must pass. Start only when autostart is on AND the app's own
# autostart file is absent -- where that file exists, it is what launches JamesDSP.
# We use %h to represent the user's home folder.
ExecCondition=/bin/sh -c "grep -q 'AutoStartEnabled=true' %h/.config/jamesdsp/application.conf"
ExecCondition=/bin/sh -c "! test -e %h/.config/autostart/jdsp-gui.desktop"

ExecStart=jamesdsp -t
Restart=on-failure
RestartSec=3
Slice=session.slice

[Install]
WantedBy=default.target
